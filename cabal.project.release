index-state:
  -- Bump this if you need newer packages from Hackage
  -- current date: io-classes-1.11 support
  , hackage.haskell.org 2026-10-23T00:00:00Z

packages:
  ./lsm-tree
  ./blockio

tests: True
benchmarks: True

-- TODO: remove once fs-sim allows io-classes-1.11
-- (needs a Hackage revision or release of fs-sim)
allow-newer: fs-sim:io-classes

-- TODO: remove this section once all dependencies fully support GHC 9.14
if impl (ghc >= 9.14)
  allow-newer:
      cborg:base
    , safe-wild-cards:template-haskell
    , serialise:base
